// Strategy: F40d C104 — ADX 14 v2 FIXED 100 ETH
// Same entry/exit logic as v2 but flat 100 ETH per trade — no streakMult, no volMult, no signalMult
// Purpose: see the raw edge without leverage amplification; assess funded platform viability
//@version=5
strategy("F40d C104 v2 — Fixed 100 ETH", overlay=true,
     initial_capital=10000,
     commission_type="percent", commission_value=0.04,
     slippage=2,
     pyramiding=0,
     process_orders_on_close=true)

// === Inputs ===
fixedQty   = input.float(100.0, "Fixed Qty (ETH)",    minval=0.01, step=1.0)
adxThresh  = input.int(20,      "ADX Threshold",      minval=8, maxval=35, step=1)
slPct      = input.float(2.0,   "Stop Loss %",        minval=1.0, maxval=5.0,  step=0.25)
tpPct      = input.float(5.0,   "Take Profit %",      minval=3.0, maxval=12.0, step=0.5)
expansionZ = input.float(1.0,   "Expansion Z-Threshold", minval=0.5, maxval=2.0, step=0.1)
minVelZ    = input.float(0.5,   "Min Velocity Z-Score",  minval=0.2, maxval=1.5, step=0.1)
detrendLen = input.int(50,      "Detrend Length",     minval=30, maxval=70, step=5)
useShorts  = input.bool(true,   "Enable Shorts")

// === ADX ===
adxLen          = 14
tr              = math.max(high - low, math.abs(high - nz(close[1], close)), math.abs(low - nz(close[1], close)))
up              = high - nz(high[1], high)
down            = nz(low[1], low) - low
plusDM          = up > down and up > 0 ? up : 0
minusDM         = down > up and down > 0 ? down : 0
smoothedTR      = ta.rma(tr, adxLen)
smoothedPlusDM  = ta.rma(plusDM, adxLen)
smoothedMinusDM = ta.rma(minusDM, adxLen)
plusDI          = 100 * smoothedPlusDM  / (smoothedTR + 1e-10)
minusDI         = 100 * smoothedMinusDM / (smoothedTR + 1e-10)
dx              = 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI + 1e-10)
adx             = ta.rma(dx, adxLen)

// === Regime — daily 200-EMA ===
htfEMA200  = request.security(syminfo.tickerid, "D", ta.ema(close, 200), lookahead=barmerge.lookahead_off)
regimeBull = close > htfEMA200
sideways   = adx < adxThresh

// === Envelope + velocity ===
envBaseLen   = 150
envSmoothLen = 10
envSlopeLen  = 10
priceVelLen  = 5

trend   = ta.sma(close, detrendLen)
osc     = nz(close - trend)
quad    = 0.0962 * osc + 0.5769 * nz(osc[2]) - 0.5769 * nz(osc[4]) - 0.0962 * nz(osc[6])
envInst = math.sqrt(osc * osc + quad * quad)
env     = ta.ema(envInst, envSmoothLen)
envSlope     = env - nz(env[envSlopeLen], env)
envSlopeMean = nz(ta.sma(envSlope, envBaseLen))
envSlopeStd  = ta.stdev(envSlope, envBaseLen)
envExpZ      = (envSlope - envSlopeMean) / math.max(nz(envSlopeStd), 1e-10)

priceVel     = close - nz(close[priceVelLen], close)
priceVelMean = nz(ta.sma(priceVel, envBaseLen))
priceVelStd  = ta.stdev(priceVel, envBaseLen)
priceVelZ    = (priceVel - priceVelMean) / math.max(nz(priceVelStd), 1e-10)

// === Signals ===
expansionEdge = ta.crossover(envExpZ, expansionZ)
ready         = bar_index > detrendLen + envBaseLen + 50

goLong  = expansionEdge and priceVel > 0 and math.abs(priceVelZ) > minVelZ and regimeBull and not sideways
goShort = expansionEdge and priceVel < 0 and math.abs(priceVelZ) > minVelZ and not sideways

// === Entries — flat 100 ETH every time ===
if not regimeBull and strategy.position_size > 0
    strategy.close("Long", comment="bear-exit")
if sideways and strategy.position_size > 0
    strategy.close("Long",  comment="sideways-exit")
    strategy.close("Short", comment="sideways-exit")
if goShort and strategy.position_size > 0
    strategy.close("Long", comment="flip-short")
if goLong and strategy.position_size < 0
    strategy.close("Short", comment="flip-long")

if goLong and ready
    strategy.entry("Long", strategy.long, qty=fixedQty)
if useShorts and goShort and ready
    strategy.entry("Short", strategy.short, qty=fixedQty)

// === Exits — fixed TP/SL bracket ===
strategy.exit("L-brk", from_entry="Long",
     limit = strategy.position_avg_price * (1 + tpPct / 100),
     stop  = strategy.position_avg_price * (1 - slPct / 100))
if useShorts
    strategy.exit("S-brk", from_entry="Short",
         limit = strategy.position_avg_price * (1 - tpPct / 100),
         stop  = strategy.position_avg_price * (1 + slPct / 100))

// === Plots ===
plot(htfEMA200, "Daily 200-EMA", color=color.purple, linewidth=2)
bgcolor(regimeBull ? color.new(color.green, 95) : color.new(color.red, 95))

// === Funded platform dashboard ===
// Shows live P&L, drawdown, and daily loss vs typical prop firm limits
var float startEquity   = na
var float peakEquity    = na
var float dayStartEq    = na
var int   lastDay       = na

if na(startEquity)
    startEquity := strategy.equity
    peakEquity  := strategy.equity

if strategy.equity > peakEquity
    peakEquity := strategy.equity

curDay = dayofmonth
if na(lastDay) or curDay != lastDay
    dayStartEq := strategy.equity
    lastDay    := curDay

totalDD  = (peakEquity - strategy.equity) / math.max(peakEquity, 1e-10) * 100
dailyPnL = (strategy.equity - nz(dayStartEq, strategy.equity)) / math.max(nz(dayStartEq, strategy.equity), 1e-10) * 100

// Prop firm limits (typical Apex/Topstep)
maxTotalDD  = 6.0   // %
maxDailyLoss = 2.0  // %

ddBreached    = totalDD   > maxTotalDD
dailyBreached = dailyPnL  < -maxDailyLoss

bgcolor(ddBreached    ? color.new(color.red,    70) : na, title="DD breach")
bgcolor(dailyBreached ? color.new(color.orange, 70) : na, title="Daily loss breach")

var table dash = table.new(position.top_right, 2, 5, border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "Metric",       text_color=color.gray,  bgcolor=color.new(color.black, 80))
    table.cell(dash, 1, 0, "Value",        text_color=color.gray,  bgcolor=color.new(color.black, 80))
    table.cell(dash, 0, 1, "Total DD",     text_color=color.white, bgcolor=color.new(color.black, 85))
    table.cell(dash, 1, 1, str.tostring(totalDD,  "#.##") + "%", text_color=totalDD > maxTotalDD ? color.red : color.green, bgcolor=color.new(color.black, 85))
    table.cell(dash, 0, 2, "Daily P&L",   text_color=color.white, bgcolor=color.new(color.black, 85))
    table.cell(dash, 1, 2, str.tostring(dailyPnL, "#.##") + "%", text_color=dailyPnL < -maxDailyLoss ? color.red : color.green, bgcolor=color.new(color.black, 85))
    table.cell(dash, 0, 3, "Net P&L",     text_color=color.white, bgcolor=color.new(color.black, 85))
    table.cell(dash, 1, 3, str.tostring((strategy.equity - startEquity) / math.max(startEquity,1e-10) * 100, "#.##") + "%", text_color=color.white, bgcolor=color.new(color.black, 85))
    table.cell(dash, 0, 4, "Trades",      text_color=color.white, bgcolor=color.new(color.black, 85))
    table.cell(dash, 1, 4, str.tostring(strategy.closedtrades),  text_color=color.white, bgcolor=color.new(color.black, 85))
