# Toobit bot instance — copy to .env.toobit and fill in

# Telegram (same bot, same chat as Bybit bot)
TELEGRAM_TOKEN=your_telegram_token
TELEGRAM_CHAT_ID=your_chat_id

# Exchange
EXCHANGE=toobit
TOOBIT_API_KEY=your_toobit_api_key
TOOBIT_API_SECRET=your_toobit_api_secret

# Strategy — equity-based sizing for $300 account
# effCash = min(equity × volMult × signalMult × streakMult, equity × 1.5)
START_EQUITY=300    # account starting capital — drives position sizing
LEVERAGE=25         # 25x; liquidation ~4%, SL at 2% triggers first
SYMBOL=ETHUSDT
# Base trade ≈ $300 notional → TP $15 / SL -$6 ; max trade $450 → TP $22 / SL -$9

# Server — different port so both bots run side by side
PORT=3001
DEPLOY_SECRET=change_this_to_a_random_secret
